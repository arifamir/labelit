<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the keys Xcode generates (GENERATE_INFOPLIST_FILE). Holds what build settings can't express. -->
<plist version="1.0">
<dict>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Rename with LabelIt</string>
			</dict>
			<key>NSMessage</key>
			<string>renameFiles</string>
			<key>NSPortName</key>
			<string>LabelIt</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.image</string>
				<string>public.movie</string>
				<string>com.adobe.pdf</string>
			</array>
			<!-- Present (even empty) so the item is on by default, without a trip to Keyboard settings. -->
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
